{
  "name": "@agentmfa/agentmfa-plugin",
  "version": "1.0.0",
  "description": "Requires biometric approval on your phone before OpenClaw can run sensitive commands",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "peerDependencies": {
    "@openclaw/plugin-sdk": ">=2026.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.4.0",
      "minGatewayVersion": ">=2026.4.0"
    },
    "build": {
      "openclawVersion": "2026.4.0",
      "pluginSdkVersion": "2026.4.0"
    }
  }
}
